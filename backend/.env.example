# PostgreSQL (démarré via docker-compose à la racine du repo)
DATABASE_URL="postgresql://split:split@localhost:5432/split?schema=public"

# Redis (cache des seeds actifs + rate limiting)
REDIS_URL="redis://localhost:6379"

# Port d'écoute de l'API Fastify
PORT=3001

# Secret JWT (stub d'auth pour le dev local — à remplacer par un vrai IdP en prod)
JWT_SECRET="change-me-in-production"

# Multiplicateur appliqué par round survécu (house edge ~3% sur un jeu 50/50)
SPLIT_ROUND_MULTIPLIER=1.94
